.next-locked-*/
.next.old-*/
.next.stale*/
.next.st-*/
.next.bak*/
.workbuddy/
dev*.log
build*.log
/data/*.db-shm
/data/*.db-wal

# neon cli context
.neon

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
start.log

# local runtime logs
validate.log
.superpowers/

--full-page

