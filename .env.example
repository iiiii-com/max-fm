# ============ Max 财经数据平台 ============
# 复制为 .env.local 使用。生产环境在 Vercel 项目设置中配置。

# 数据库：设置后使用 PostgreSQL（如 Neon），不设置则使用本地 SQLite（data/max.db，零配置演示）
# DATABASE_URL=postgresql://user:pass@host/db

# 会话密钥 —— 生产环境必填。
# 未配置或短于 32 字符时应用拒绝启动。此前这里有一个公开的默认兜底值，
# 意味着任何人都能自己签出任意用户的会话令牌（含付费状态），因此必须显式配置。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# 密码重置邮件的发件人。留空时重置链接只写入服务端日志且不返回给前端，
# 接入邮件服务前，/forgot-password 不构成可用的自助找回流程。
# AUTH_MAIL_FROM=noreply@your-domain.com

# ============ AI 模型（多模型混合，全部可选） ============
# 通用 OpenAI 兼容端点（DeepSeek / GLM / Qwen / Moonshot 等任意兼容服务）
# AI_API_KEY=sk-xxx
# AI_BASE_URL=https://api.deepseek.com/v1

# 强模型（月度报告 / 政策解读 / 温差报告等高质量任务）
# AI_STRONG_MODEL=deepseek-chat
# AI_STRONG_BASE_URL=https://api.deepseek.com/v1
# AI_STRONG_API_KEY=sk-xxx

# 廉价模型（每日复盘 / 周报等高频任务）
# AI_CHEAP_MODEL=glm-4-flash
# AI_CHEAP_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_CHEAP_API_KEY=sk-xxx

# 未配置任何 Key 时，所有 AI 内容自动降级为内置模板，站点功能不受影响。

# ============ Cron 保护 ============
# 与 vercel.json 中 crons 的 secret 参数保持一致（部署时替换 __CRON_SECRET__）
# CRON_SECRET=some-random-string